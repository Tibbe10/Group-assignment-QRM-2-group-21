knitr::opts_chunk$set(echo = TRUE)
mean(movies$vote_average, na.rm = TRUE)
set.seed(123)
movies_sample <- movies[sample(nrow(movies), 25), ]
mean(movies_sample$vote_average)
#WRITE YOUR CODE HERE
movies$revenue_millions <- movies$revenue / 1000000
var(movies$revenue_millions[movies$director_gender == "male"], na.rm = TRUE)
var(movies$revenue_millions[movies$director_gender == "female"], na.rm = TRUE)
#WRITE YOUR CODE HERE
male_var <- var(movies$revenue_millions[movies$director_gender == "male"], na.rm = TRUE)
female_var <- var(movies$revenue_millions[movies$director_gender == "female"], na.rm = TRUE)
n_female <- sum(movies$director_gender == "female", na.rm = TRUE)
test_stat <- (n_female - 1) * female_var / male_var
test_stat
p_value <- 2 * min(
pchisq(test_stat, df = n_female - 1),
1 - pchisq(test_stat, df = n_female - 1)
)
p_value
